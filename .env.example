# Server-side keys only. Never commit real values. Copy to .env.local for local dev,
# and add the same names in Vercel > Project > Settings > Environment Variables.

# Subscriber storage (Mission OS Supabase project, table public.dss_subscribers).
# The PUBLIC publishable key is enough: it can only call the dss_subscribe() function.
SUPABASE_URL=https://ikdrzrporaqbqslrbngo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CaazW-Wun9oyu1mWAGeFug_OdOPVXYh

# Email (Resend, missiondrivenbrand account). From address must be on a domain verified in Resend.
RESEND_API_KEY=
DSS_FROM_EMAIL="Morning Lamp <study@morninglamp.study>"
DSS_REPLY_TO_EMAIL=

# Google Tag Manager container (public). GA4 G-PJBD873773 is configured inside GTM.
NEXT_PUBLIC_GTM_ID=GTM-TP8WP5KL

# Inbound mail: hello@morninglamp.study is relayed to DSS_FORWARD_TO by /api/inbound (Resend webhook).
RESEND_WEBHOOK_SECRET=
DSS_FORWARD_TO=

# Stripe (Founders checkout). Use sk_test_ keys until going live. The Founders card is hidden until this is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Gate secret the Stripe webhook uses to write Founders/commissions (also stored in dss_config)
DSS_DB_GATE=

# Later
# CRON_SECRET=

# Partner program
SESSION_SECRET=          # signs partner sign-in cookies (openssl rand -hex 32)
ADMIN_EMAILS=            # comma-separated; can open /admin/partners
CRON_SECRET=             # Vercel Cron sends it as a Bearer token to /api/cron/daily

# Daily study emails
ANTHROPIC_API_KEY=       # Claude writes each day's study (lib/studyWriter.ts)
DSS_POSTAL_ADDRESS=      # mailing address printed in every email footer (required by CAN-SPAM)
